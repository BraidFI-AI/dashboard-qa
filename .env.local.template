# Braid Testing Environment Configuration
# Copy this file to .env.local and fill in actual values
# DO NOT commit .env.local to version control

# Environment (development, staging, production)
BRAID_ENV=development

# Braid API Base URL
BRAID_BASE_URL=https://development.braid.zone

# API Authentication - API Key
BRAID_API_KEY=your_actual_api_key_here

# Test User Credentials
BRAID_TEST_USERNAME=your_test_username_here
BRAID_TEST_PASSWORD=your_test_password_here

# Product ID - Use existing product (DO NOT create new)
BRAID_PRODUCT_ID=1069832

# Optional: Additional Configuration
# BRAID_TIMEOUT=30000
# BRAID_LOG_LEVEL=debug
